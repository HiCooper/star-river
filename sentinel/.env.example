# 星河哨兵 · 环境变量配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API Key (AI 分诊引擎)
DEEPSEEK_API_KEY=sk-your-key-here

# AI Engine URL (platform 调用 AI 引擎)
AI_ENGINE_URL=http://localhost:8083

# Platform
PORT=8082
GIN_MODE=debug
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://hydra:hydra_secret@localhost:5432/sentinel?sslmode=disable
